# ---- App ----
DATABASE_URL=mysql+pymysql://forestwatch:change_me@localhost:3306/forestwatch
JWT_SECRET=replace-with-64-random-hex-chars   # python -c "import secrets;print(secrets.token_hex(32))"
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173
IMAGE_DIR=./data/images

# ---- Satellite provider: "sentinelhub" (services.sentinel-hub.com) or "cdse" (Copernicus Data Space) ----
SH_PROVIDER=cdse
# OAuth client (client-credentials). Sentinel Hub: dashboard.sentinel-hub.com > User settings > OAuth clients
# CDSE: shapps.dataspace.copernicus.eu/dashboard > OAuth clients
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# ---- Global Forest Watch Data API key (https://www.globalforestwatch.org/help/developers/guides/create-and-use-an-api-key/) ----
GFW_API_KEY=

# ---- Detection thresholds (calibrate per region) ----
NDVI_FOREST_MIN=0.60       # pixel counted as forest in the older image
NDVI_LOSS_MAX=0.35         # pixel is bare/cleared in the recent image
NDVI_DROP_MIN=0.25         # minimum NDVI decrease for "suspected loss"
NDVI_UNCERTAIN_DROP=0.15   # smaller drops are flagged as uncertain (seasonal?)
NBR_BURN_DROP=0.27         # dNBR above this AND dark NIR (below) => probable fire scar, not clearing
BURN_MAX_NIR=0.18          # post-event NIR reflectance ceiling for a burn scar
MIN_PATCH_PIXELS=8         # drop isolated clusters smaller than this
MAX_CLOUD_COVER=30

# ---- Alert severity (hectares of suspected loss) ----
ALERT_MIN_HA=1
SEV_MEDIUM_HA=10
SEV_HIGH_HA=50
SEV_CRITICAL_HA=200

# ---- Monitoring scheduler ----
SCHEDULER_TICK_MINUTES=30

# ---- Optional email notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@forestwatch.local
